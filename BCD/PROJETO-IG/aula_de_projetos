-- DDL | CRIAÇÃO DE TABELA
CREATE TABLE USUARIO (
    ID_USUARIO INT AUTO_INCREMENT PRIMARY KEY,
    NOME VARCHAR(100) NOT NULL,
    EMAIL VARCHAR(150) NOT NULL UNIQUE,
    TELEFONE VARCHAR(14) NOT NULL UNIQUE,
    CPF VARCHAR(14) NOT NULL UNIQUE,
    CONTATO_EMERGENCIA VARCHAR(14) NOT NULL UNIQUE,
    TERMO_DE_CONSENTIMENTO VARCHAR(20) DEFAULT 'AUTORIZADO' CHECK (TERMO_DE_CONSENTIMENTO IN ('AUTORIZADO','NAO AUTORIZADO'))
    
);
SELECT * FROM usuario;


CREATE TABLE EQUIPAMENTO (
    ID_EQUIPAMENTO INT AUTO_INCREMENT PRIMARY KEY,
    PATRIMONIO VARCHAR(100) NOT NULL UNIQUE,
    MODELO VARCHAR(100) NOT NULL,
    QUANTIDADE VARCHAR(100) NOT NULL,
    ESPECIFICACAO_TECNICA VARCHAR(100) NOT NULL,
    SETOR VARCHAR(100) NOT NULL,
    STATUS_ATUAL VARCHAR(20) DEFAULT 'ATIVO' CHECK (STATUS_ATUAL IN ('ATIVO', 'EM MANUTENCAO', 'AGUARDANDO CALIBRACAO', 'DESCARTADO'))
);
SELECT * FROM equipamento;

CREATE TABLE TECNICO (
    ID_TECNICO INT AUTO_INCREMENT PRIMARY KEY,
    NOME VARCHAR(100) NOT NULL,
    TELEFONE VARCHAR(13) NOT NULL,
    CPF VARCHAR(14) NOT NULL,
    ENDERECO VARCHAR(100) NOT NULL,
    ESPECIALIDADE VARCHAR(100) NOT NULL,
    STATUS_SISTEMA VARCHAR(20) DEFAULT 'ATIVO' CHECK (STATUS_SISTEMA IN ('ATIVO', 'AFASTADO'))
);

SELECT * FROM tecnico;

CREATE TABLE CHAMADO (
    ID_CHAMADO INT PRIMARY KEY AUTO_INCREMENT,
    DESCRICAO VARCHAR(150),
    CATEGORIA VARCHAR(100) NOT NULL,
    PRIORIDADE VARCHAR(25) DEFAULT 'MEDIO(A)' CHECK (PRIORIDADE IN ('ALTO(A)','MEDIO(A)','BAIXO(A)')),
    STATUS VARCHAR(20) DEFAULT 'ABERTO' CHECK (STATUS IN ('ABERTO', 'EM ANDAMENTO', 'FINALIZADO')),
    DATA_ABERTA TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    DATA_FECHADA DATETIME NULL,
    SOLUCAO_APLICADA VARCHAR(250) NOT NULL,

    id_usuario INT NOT NULL,
    id_equipamento INT NULL,
    id_tecnico INT NULL,

    CONSTRAINT fk_chamado_usuario 
        FOREIGN KEY (id_usuario) REFERENCES usuario(id_usuario),
        
    CONSTRAINT fk_chamado_equipamento 
        FOREIGN KEY (id_equipamento) REFERENCES equipamento(id_equipamento),
        
    CONSTRAINT fk_chamado_tecnico 
        FOREIGN KEY (id_tecnico) REFERENCES tecnico(id_tecnico)

);
SELECT * FROM chamado;

CREATE TABLE AMBIENTES (
    ID_AMBIENTES INT AUTO_INCREMENT PRIMARY KEY,
    NOME_SALA VARCHAR(20) NOT NULL UNIQUE,
    ANDAR VARCHAR(25) DEFAULT 'TERREO' CHECK (ANDAR IN ('TERREO', '1°ANDAR')),
    HORARIO_FUNCIONAMENTO VARCHAR(45),
    INTERFONE_SALA VARCHAR(14) NOT NULL UNIQUE,
    TIPO_AMBIENTE VARCHAR(40) DEFAULT 'CONSULTORIO' CHECK (TIPO_AMBIENTE IN('RECEPCAO','CONSULTORIO','TRIAGEM','COLETA','AUDIOMETRIA','EXAMES COMPLEMENTARES'))

);
SELECT * FROM ambientes;